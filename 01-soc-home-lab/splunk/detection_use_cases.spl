# ============================================================================
# SOC Home Lab - Splunk Detection Use Cases (SPL)
# Author: Kuldeep J. Jotaniya
#
# 12 detection use cases mapped to MITRE ATT&CK. Each query assumes Windows
# Security/System logs and Sysmon are ingested under index=windows with the
# Splunk Add-on for Microsoft Windows providing CIM field extractions.
#
# Sysmon events use source="WinEventLog:Microsoft-Windows-Sysmon/Operational".
# ============================================================================

# ---------------------------------------------------------------------------
# UC-001 | Suspicious PowerShell Execution
# MITRE: T1059.001 (PowerShell) | Severity: High
# Triage: Inspect parent process, decode any -enc/base64 payloads, escalate.
# ---------------------------------------------------------------------------
index=windows (EventCode=4688 OR (source="*Sysmon*" EventCode=1))
    (CommandLine="*powershell*" OR Image="*\\powershell.exe" OR Image="*\\pwsh.exe")
    (CommandLine="*-enc*" OR CommandLine="*-EncodedCommand*" OR CommandLine="*FromBase64String*"
     OR CommandLine="*-nop*" OR CommandLine="*-w hidden*" OR CommandLine="*DownloadString*"
     OR CommandLine="*IEX*" OR CommandLine="*Invoke-Expression*")
| stats count min(_time) as first_seen max(_time) as last_seen
    values(ParentImage) as parent_process values(User) as user by CommandLine, host
| convert ctime(first_seen) ctime(last_seen)
| sort - count


# ---------------------------------------------------------------------------
# UC-002 | Multiple Failed Logins (Brute Force) followed by success
# MITRE: T1110 (Brute Force) / T1078 (Valid Accounts) | Severity: Medium
# Triage: Block source IP, notify account owner, hunt for 4624 success after.
# ---------------------------------------------------------------------------
index=windows EventCode=4625
| stats count as failed_attempts values(Workstation_Name) as workstation
    dc(Account_Name) as distinct_accounts by src_ip, Account_Name
| where failed_attempts > 5
| sort - failed_attempts


# Companion: failed bursts immediately followed by a successful logon (4624)
index=windows (EventCode=4625 OR EventCode=4624)
| transaction Account_Name maxspan=10m
| where eventcount > 6 AND searchmatch("EventCode=4624")
| table _time Account_Name src_ip eventcount


# ---------------------------------------------------------------------------
# UC-003 | New / Suspicious Service Installed
# MITRE: T1543.003 (Windows Service) | Severity: High
# Triage: Verify service legitimacy, hash-check ServiceFileName in VirusTotal.
# ---------------------------------------------------------------------------
index=windows EventCode=7045
| eval suspicious=if(match(ServiceFileName, "(?i)(\\\\temp\\\\|\\\\appdata\\\\|powershell|cmd\\.exe|\\.bat|\\.vbs)"), "yes", "no")
| table _time host ServiceName ServiceFileName ServiceType StartType suspicious
| sort - _time


# ---------------------------------------------------------------------------
# UC-004 | Credential Dumping - LSASS Access (Mimikatz-style)
# MITRE: T1003.001 (LSASS Memory) | Severity: Critical
# Triage: Isolate host, capture memory, rotate exposed credentials.
# ---------------------------------------------------------------------------
index=windows source="*Sysmon*" EventCode=10 TargetImage="*\\lsass.exe"
    (GrantedAccess="0x1010" OR GrantedAccess="0x1410" OR GrantedAccess="0x1438"
     OR GrantedAccess="0x143a" OR GrantedAccess="0x1fffff")
| stats count values(GrantedAccess) as access by SourceImage, TargetImage, host, User
| sort - count


# ---------------------------------------------------------------------------
# UC-005 | Registry Run Key Persistence
# MITRE: T1547.001 (Registry Run Keys / Startup Folder) | Severity: High
# Triage: Validate added autostart entry, remove if unauthorised.
# ---------------------------------------------------------------------------
index=windows source="*Sysmon*" EventCode=13
    TargetObject="*\\CurrentVersion\\Run*"
| table _time host Image TargetObject Details User
| sort - _time


# ---------------------------------------------------------------------------
# UC-006 | Ingress Tool Transfer (download via LOLBins)
# MITRE: T1105 (Ingress Tool Transfer) | Severity: High
# Triage: Inspect downloaded artefact, hash-check, sandbox if unknown.
# ---------------------------------------------------------------------------
index=windows (EventCode=4688 OR (source="*Sysmon*" EventCode=1))
    (CommandLine="*certutil*-urlcache*" OR CommandLine="*bitsadmin*/transfer*"
     OR CommandLine="*Invoke-WebRequest*" OR CommandLine="*curl *http*"
     OR CommandLine="*wget *http*" OR CommandLine="*DownloadFile*")
| table _time host User Image CommandLine
| sort - _time


# ---------------------------------------------------------------------------
# UC-007 | Suspicious Outbound C2 Beacon (rare external destinations)
# MITRE: T1071 (Application Layer Protocol) | Severity: High
# Triage: Correlate with threat intel, review beacon interval/jitter.
# ---------------------------------------------------------------------------
index=windows source="*Sysmon*" EventCode=3 Initiated="true"
    NOT (DestinationIp="10.0.0.0/8" OR DestinationIp="172.16.0.0/12" OR DestinationIp="192.168.0.0/16")
| stats count dc(DestinationIp) as dst_ips values(DestinationPort) as ports
    by Image, host
| where count > 50 AND dst_ips < 3
| sort - count


# ---------------------------------------------------------------------------
# UC-008 | Exploit Public-Facing Application - web shell spawn
# MITRE: T1190 (Exploit Public-Facing Application) | Severity: Critical
# Triage: Identify dropped web shell, review web server access logs.
# ---------------------------------------------------------------------------
index=windows source="*Sysmon*" EventCode=1
    ParentImage IN ("*\\w3wp.exe","*\\httpd.exe","*\\nginx.exe","*\\tomcat*.exe")
    Image IN ("*\\cmd.exe","*\\powershell.exe","*\\whoami.exe","*\\net.exe")
| table _time host ParentImage Image CommandLine User
| sort - _time


# ---------------------------------------------------------------------------
# UC-009 | Account Created or Added to Privileged Group
# MITRE: T1136 (Create Account) / T1098 (Account Manipulation) | Severity: High
# Triage: Confirm change-management ticket exists, else disable account.
# ---------------------------------------------------------------------------
index=windows (EventCode=4720 OR EventCode=4728 OR EventCode=4732 OR EventCode=4756)
| eval action=case(EventCode=4720,"user created",
                   EventCode=4728,"added to global group",
                   EventCode=4732,"added to local group",
                   EventCode=4756,"added to universal group")
| table _time host action Target_Account_Name Group_Name Subject_Account_Name
| sort - _time


# ---------------------------------------------------------------------------
# UC-010 | Windows Defender / Security Tooling Tampering
# MITRE: T1562.001 (Disable or Modify Tools) | Severity: High
# Triage: Re-enable protection, investigate the user/process responsible.
# ---------------------------------------------------------------------------
index=windows (EventCode=4688 OR (source="*Sysmon*" EventCode=1))
    (CommandLine="*Set-MpPreference*DisableRealtimeMonitoring*"
     OR CommandLine="*Add-MpPreference*ExclusionPath*"
     OR CommandLine="*sc * stop WinDefend*"
     OR CommandLine="*netsh * firewall set opmode disable*")
| table _time host User Image CommandLine
| sort - _time


# ---------------------------------------------------------------------------
# UC-011 | Scheduled Task Created for Persistence
# MITRE: T1053.005 (Scheduled Task) | Severity: Medium
# Triage: Inspect task action/trigger, remove if unauthorised.
# ---------------------------------------------------------------------------
index=windows (EventCode=4698 OR (EventCode=4688 CommandLine="*schtasks*/create*"))
| table _time host Task_Name Account_Name CommandLine
| sort - _time


# ---------------------------------------------------------------------------
# UC-012 | Cleared Security Event Log (anti-forensics)
# MITRE: T1070.001 (Clear Windows Event Logs) | Severity: High
# Triage: Treat as high-confidence IoC; pivot to other telemetry sources.
# ---------------------------------------------------------------------------
index=windows (EventCode=1102 OR EventCode=104)
| table _time host EventCode Account_Name Message
| sort - _time
